.menu-container {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgba(20, 20, 20, 0.95);
}

.title {
    font-size: 42px;
    color: #FFFFFF;
    margin-bottom: 30px;
    -unity-font-style: bold;
}

.menu-button {
    width: 220px;
    height: 50px;
    margin-bottom: 15px;
    font-size: 18px;
    border-radius: 8px;
    border-width: 0;
    background-color: #2D3748;
    color: #FFFFFF;
    transition-duration: 0.15s;
}

.menu-button:hover {
    background-color: #4A5568;
    scale: 1.05 1.05;
}

.menu-button:active {
    background-color: #1A202C;
}