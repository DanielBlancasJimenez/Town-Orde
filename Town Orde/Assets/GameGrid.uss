.game-container {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: #333333;
}

.grid-board {
    width: 600px;
    height: 600px;
    background-color: #D1D5DB;
    border-radius: 18px;
    overflow: hidden;
    border-width: 1px;
    border-color: #9CA3AF;
}

.grid-row {
    flex-direction: row;
    flex-grow: 1;
    width: 100%;
}

.grid-cell {
    flex-grow: 1;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-color: #9CA3AF;
    background-color: transparent;
    border-radius: 0;
    margin: 0;
    padding: 0;
}

/* Quitar el borde derecho en la última columna */
.grid-cell-last-col {
    border-right-width: 0;
}

/* Quitar el borde inferior en la última fila */
.grid-row-last .grid-cell {
    border-bottom-width: 0;
}

.grid-cell:hover {
    background-color: rgba(255, 255, 255, 0.2);
}