/* --- LAYOUT PRINCIPAL --- */
.main-layout {
    flex-direction: row;
    flex-grow: 1;
    background-color: #F3F4F6;
    padding: 20px;
    justify-content: space-between;
}

.side-panel {
    width: 25%;
    flex-direction: column;
    justify-content: space-between;
}

.right-panel {
    align-items: flex-end;
}

.center-panel {
    width: 45%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

/* --- CAJAS GENÉRICAS (Estilo Wireframe) --- */
.box {
    background-color: #FFFFFF;
    border-color: #6B7280;
    border-width: 3px;
    border-radius: 8px;
    justify-content: center;
    align-items: center;
    padding: 10px;
}

.text-center {
    -unity-text-align: middle-center;
    font-size: 16px;
    color: #1F2937;
}

.wrap-text {
    white-space: normal;
}

/* --- TAMAÑOS ESPECÍFICOS PANEL IZQUIERDO --- */
.king-box { height: 150px; margin-bottom: 20px; }
.info-box { flex-grow: 1; margin-bottom: 20px; }
.upgrade-box { height: 80px; }

/* --- TAMAÑOS ESPECÍFICOS PANEL DERECHO --- */
.menu-btn { height: 60px; width: 120px; margin-bottom: 20px; background-color: #FFFFFF; }
.towers-box { flex-grow: 1; width: 100%; margin-bottom: 20px; }
.start-btn { height: 100px; width: 100%; background-color: #FFFFFF; }

.menu-btn:hover, .start-btn:hover { background-color: #E5E7EB; }

/* --- PANEL CENTRAL (Grid y Slots) --- */
.title-center {
    font-size: 32px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    color: #1F2937;
}

.subtitle-center {
    font-size: 14px;
    margin-top: 20px;
    margin-bottom: 5px;
    color: #4B5563;
}

.tower-slots {
    flex-direction: row;
    height: 80px;
    width: 100%;
}

.slot {
    flex-grow: 1;
    border-color: #D1D5DB;
    border-width: 1px;
    background-color: #FFFFFF;
    border-radius: 8px;
    margin: 0 5px;
}

/* --- ESTILOS DEL GRID 8x8 --- */
.grid-board {
    width: 100%;
    height: 500px; /* Ajusta la altura según la proporción que desees */
    background-color: #FFFFFF;
    border-radius: 12px;
    border-width: 2px;
    border-color: #9CA3AF;
    overflow: hidden;
}

.grid-row {
    flex-direction: row;
    flex-grow: 1;
    width: 100%;
}

.grid-cell {
    flex-grow: 1;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-color: #D1D5DB;
    background-color: transparent;
    border-radius: 0;
    margin: 0;
    padding: 0;
}

.grid-cell-last-col { border-right-width: 0; }
.grid-row-last .grid-cell { border-bottom-width: 0; }
.grid-cell:hover { background-color: rgba(0, 0, 0, 0.05); }